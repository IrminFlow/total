"<!doctype html><html><head><meta charset="utf-8"><title>Invoice INV-SAMPLE-1</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font: 11px/1.5 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif; color: #1b1f24; }
    .num { font-variant-numeric: tabular-nums; }
    .copy { page-break-after: always; }
    .copy:last-child { page-break-after: auto; }

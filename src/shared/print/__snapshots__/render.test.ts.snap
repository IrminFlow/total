      </div>
      <div class="sig">
        <div>Receiver's signature</div>
        
        <div class="for">For <b>Total Traders</b><br/><br/><br/>Authorised Signatory</div>
      </div>
      
    </div>
      </div></body></html>"
`;

exports[`built-in templates on the sample invoice (snapshots) > Compact renders stably 1`] = `
"<!doctype html><html><head><meta charset="utf-8"><title>Invoice INV-SAMPLE-1</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font: 10px/1.35 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a; }
    .num { font-variant-numeric: tabular-nums; font-family: 'IBM Plex Mono', 'SF Mono', Menlo, monospace; font-size: 9.58px; }
    .copy { page-break-after: always; }
    .copy:last-child { page-break-after: auto; }
    .copy-label { text-align: right; font-size: 8.33px; text-transform: uppercase; letter-spacing: 0.08em; color: #666; margin-bottom: 3px; }
    .sheet { border: 1px solid #222222; }
    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; border-bottom: 1px solid #222222; padding: 8px 10px; }
    h1 { font-size: 14.17px; letter-spacing: 0.01em; }
    .tag { text-align: right; font-size: 9.17px; }
    .tag b { font-size: 11.25px; letter-spacing: 0.1em; }
    .meta { display: flex; border-bottom: 1px solid #222222; }
    .meta > div { flex: 1; padding: 6px 10px; }
    .meta > div + div { border-left: 1px solid #bbb; }
    .lbl { font-size: 7.5px; text-transform: uppercase; letter-spacing: 0.08em; color: #666; margin-bottom: 1px; }
    table.items { width: 100%; border-collapse: collapse; }
    table.items th { font-size: 7.92px; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #222222; padding: 4px 5px; text-align: left; background: #f3f3f3; }
    table.items td { padding: 3px 5px; border-bottom: 0.5px solid #ccc; vertical-align: top; }
    table.items.page-split { page-break-after: always; }
    table.items tr.cf td { font-weight: 700; border-bottom: 1px solid #222222; }
    table.hsn { width: 100%; border-collapse: collapse; border-top: 1px solid #222222; }
    table.hsn th { font-size: 7.5px; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 0.5px solid #222222; padding: 3px 5px; text-align: left; background: #f3f3f3; }
    table.hsn td { padding: 2px 5px; border-bottom: 0.5px solid #ddd; }
    .audit-foot { padding: 3px 10px; border-top: 1px solid #bbb; font-size: 7.5px; color: #666; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
    .r { text-align: right; } .c { text-align: center; }
    .bottom { display: flex; border-top: 1px solid #222222; page-break-inside: avoid; }
    .words { flex: 1; padding: 6px 10px; border-right: 1px solid #bbb; }
    table.tot { width: 230px; border-collapse: collapse; }
    table.tot td { padding: 3px 10px; }
    table.tot tr.grand td { border-top: 1px solid #222222; font-weight: 700; font-size: 10.83px; }
    .sig { display: flex; justify-content: space-between; align-items: flex-end; padding: 16px 10px 8px; border-top: 1px solid #222222; font-size: 9.17px; page-break-inside: avoid; }
    .sig .for { text-align: right; }
    .einv { padding: 5px 16px; border-bottom: 1px solid #222222; font-size: 8.33px; overflow-wrap: anywhere; }
    .cg-note { padding: 4px 16px 0; text-align: center; font-size: 7.5px; color: #666; }
  </style></head><body>
      <div class="copy">
        <div class="copy-label">Original for Recipient</div>
        
    <div class="sheet">
      <div class="head">
        <div>
          
          <h1>Total Traders</h1>
          <div>1 Market Road, Mumbai</div>
          <div class="num">GSTIN: 27AAAAA0000A1Z5 · Maharashtra</div>
          

    h1 { font-size: 19.25px; font-weight: 600; letter-spacing: -0.005em; color: #1f4f78; margin-bottom: 2px; }
    .tag { text-align: right; font-size: 10.08px; color: #4a5560; }
    .tag b { display: block; font-size: 17.42px; font-weight: 600; letter-spacing: 0.16em; color: #1f4f78; }
    .meta { display: flex; gap: 12px; margin: 14px 0; }
    .meta > div { flex: 1; padding: 10px 12px; background: rgba(31, 79, 120, 0.06); border-radius: 4px; }
    .lbl { font-size: 8.25px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #1f4f78; margin-bottom: 3px; }
    table.items { width: 100%; border-collapse: collapse; }
    table.items th { font-size: 8.71px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #1f4f78; border-bottom: 2px solid #1f4f78; padding: 7px 8px; text-align: left; }
    table.items td { padding: 7px 8px; border-bottom: 1px solid #e3e6ea; vertical-align: top; }
    table.items tbody tr:nth-child(even) td { background: #f8f9fb; }
    table.items.page-split { page-break-after: always; }
    table.items tr.cf td { font-weight: 600; border-bottom: 2px solid #1f4f78; background: none; }
    table.hsn { width: 100%; border-collapse: collapse; margin-top: 14px; }
    table.hsn th { font-size: 8.25px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #4a5560; border-bottom: 1px solid #c9ced4; padding: 5px 8px; text-align: left; }
    table.hsn td { padding: 4px 8px; border-bottom: 1px solid #eef0f2; }

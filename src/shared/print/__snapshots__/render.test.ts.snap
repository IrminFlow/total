    table.tot { width: 270px; border-collapse: collapse; align-self: flex-start; }
    table.tot td { padding: 5px 10px; }
    table.tot tr.grand td { background: #1f4f78; color: #fff; font-weight: 700; font-size: 12.38px; padding: 8px 10px; }
    .sig { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 30px; padding-top: 10px; border-top: 1px solid #e3e6ea; font-size: 10.08px; page-break-inside: avoid; }
    .sig .for { text-align: right; }

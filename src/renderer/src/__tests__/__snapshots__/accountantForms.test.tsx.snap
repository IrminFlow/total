exports[`accountant create dialogs (unchanged by WP 8.4) > LedgerFormModal — new ledger 1`] = `"<div><div class="fixed inset-0 z-40 flex items-start justify-center bg-scrim pt-[10vh]"><div role="dialog" aria-modal="true" aria-labelledby="_r_0_" data-modal="New ledger" tabindex="-1" class="max-h-[75vh] w-full max-w-lg overflow-auto rounded-xl border border-line bg-raised shadow-elev-3 outline-none"><div class="flex items-center justify-between border-b border-line px-5 py-3"><h3 id="_r_0_" class="font-serif text-title font-semibold">New ledger</h3><div class="flex items-center gap-2"><kbd class="rounded border border-line bg-panel2 px-1.5 py-0.5 font-mono text-label text-muted">Esc</kbd><button type="button" aria-label="Close" title="Close" data-testid="modal-close" class="inline-flex items-center justify-center rounded-md border border-transparent leading-none text-muted transition-colors hover:border-line hover:text-ink disabled:pointer-events-none disabled:opacity-40 h-control-sm w-control-sm text-small "><span aria-hidden="true">✕</span></button></div></div><div class="p-5"><div class="flex flex-col gap-3"><div class="grid grid-cols-2 gap-3"><div class=""><label class="block"><span class="mb-1 block text-caption font-semibold tracking-[0.08em] text-muted uppercase">Name</span><input class="w-full min-h-control rounded-md border border-line bg-panel2 px-control-x py-1 text-body text-ink placeholder:text-muted focus:border-amber/60 aria-[invalid=true]:border-danger/70 " value=""></label></div><div class=""><label class="block"><span class="mb-1 block text-caption font-semibold tracking-[0.08em] text-muted uppercase">Under group</span><select class="w-full min-h-control rounded-md border border-line bg-panel2 px-control-x py-1 text-body text-ink placeholder:text-muted focus:border-amber/60 aria-[invalid=true]:border-danger/70 "><option value="1">Current Assets</option><option value="2">Sundry Debtors</option><option value="3">Current Liabilities</option><option value="4">Sundry Creditors</option><option value="5">Sales Accounts</option><option value="6">Indirect Expenses</option></select></label></div></div><div class="grid grid-cols-2 gap-3"><div class=""><label class="block"><span class="mb-1 block text-caption font-semibold tracking-[0.08em] text-muted uppercase">Opening balance</span><div class="flex gap-2"><span class="block min-w-0 flex-1"><input class="w-full min-h-control rounded-md border border-line bg-panel2 px-control-x py-1 text-body text-ink placeholder:text-muted focus:border-amber/60 aria-[invalid=true]:border-danger/70 num text-right " data-testid="input-amount" placeholder="0.00" inputmode="decimal" value=""></span><button class="num w-12 rounded-md border border-line text-body-sm font-medium text-dr">Dr</button></div></label></div></div><div class="flex justify-between"><div></div><div class="flex gap-2"><button type="button" class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md transition-colors disabled:pointer-events-none disabled:opacity-40 min-h-control px-3 py-1 text-detail border border-line bg-panel text-ink shadow-elev-1 hover:border-amber/60 ">Cancel</button><button type="button" data-testid="btn-ledger-save" class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md transition-colors disabled:pointer-events-none disabled:opacity-40 min-h-control px-3 py-1 text-detail border border-amberbar bg-amberbar/90 font-semibold text-on-amber hover:bg-amberbar ">Save ledger</button></div></div></div></div></div></div></div>"`;


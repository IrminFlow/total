{
  "name": "total",
  "version": "0.12.0",
  "description": "Total \u2014 fully offline accounting for macOS. Tally-grade books, modern experience.",
  "main": "out/main/index.js",
  "author": "Irmin Labs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:renderer": "vitest run -c vitest.renderer.config.ts",
    "cli": "node scripts/total-cli.mjs",
    "perf": "node scripts/total-cli.mjs perf",
    "smoke": "node scripts/smoke-ci.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9",
    "openai": "^7.30.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.irminlabs.total",
    "productName": "Total",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/cli/**",
      "package.json",
      "!**/node_modules/better-sqlite3-multiple-ciphers/{deps,src,build}/**",
      "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/!(${platform}-${arch}).node"
    ],
    "extraResources": [
      {
        "from": "resources/total.png",
        "to": "total.png"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "mac": {
      "icon": "resources/total.icns",
      "category": "public.app-category.finance",
      "minimumSystemVersion": "13.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/total.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "Total",
      "uninstallDisplayName": "Total"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Total-org",
        "repo": "total-org",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
